{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"NSE JSON Strategy",
  "type":"object",
  "additionalProperties":false,
  "required":["id","index","tf","entry_call","entry_put","block_if","sl","target","time_filter"],
  "properties":{
    "id":{"type":"string","minLength":1},
    "index":{"type":"string","enum":["NIFTY","BANKNIFTY","FINNIFTY","MIDCPNIFTY","SENSEX","BANKEX"]},
    "tf":{"type":"string","enum":["1m","2m","3m","5m","10m","15m","30m","1h","2h","4h","1d"]},
    "entry_call":{"type":"array","items":{"type":"string"}},
    "entry_put":{"type":"array","items":{"type":"string"}},
    "block_if":{"type":"array","items":{"type":"string"}},
    "sl":{"type":"string","minLength":1},
    "target":{"type":"string","minLength":1},
    "time_filter":{"type":"string","pattern":"^\\d{2}:\\d{2}-\\d{2}:\\d{2}$"},
    "version":{"type":"string"}
  }
}
