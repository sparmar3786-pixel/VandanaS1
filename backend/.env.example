# Railway environment variables
# Keep real values in Railway Variables, never in GitHub or the APK.

API_TOKEN=
# Native APK sends x-app-key. Leave empty for a private single-user read-only deployment.
MCP_AUTH_TOKEN=

# Optional server-side Angel auto-login.
# App login can be used instead, so these may remain empty.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

SYMBOL=NIFTY
STRIKES_EACH_SIDE=5
POLL_SEC=5
LOOKBACK_SEC=300
SL_PCT=0.20
RR=1.5
SIGNAL_THRESHOLD=0.35
AI_MIN_CONF=0.55
NSE_POLL_SEC=60
NSE_LOG_EVERY_SEC=60
MARKET_STALE_SEC=15

# AI provider API keys (server-side only; never put these in the APK)
OPENAI_API_KEY=
OPENAI_LUNA_MODEL=gpt-5.6-luna
OPENAI_SOL_MODEL=gpt-5.6-sol
AI_TIMEOUT_SEC=15
AI_CACHE_SEC=45

# Official NSE website used as external AI evidence
NSE_SITE_URL=https://www.nseindia.com/option-chain
